{
  "private": true,
  "description": "A CLI life planner — organize areas, goals, tasks, and habits from the terminal",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @planner/cli dev",
    "dev:api": "pnpm --filter @planner/api dev",
    "dev:web": "pnpm --filter @planner/web dev",
    "dev:full": "pnpm --filter @planner/api dev & pnpm --filter @planner/web dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "pnpm -r lint"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.1",
    "@types/react": "^18.3.28",
    "drizzle-kit": "^0.30.4",
    "ink-testing-library": "^4.0.0",
    "react": "^18.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
